-- Question: Find sales and profits by region and category
-- Topics: COUNT, SUM, AVG; GROUP BY, HAVING 
-- Data source: Superstore from Kaggle, using Bigquey to code

select region, sum(sales) as total_sales_per_region
from week-1-sql-511717.Sample_superstore_kaggle.superstore
group by region;

select region, sum(profit) as total_profit_per_region
from week-1-sql-511717.Sample_superstore_kaggle.superstore
group by region;

select category, sum(sales) as total_sales_per_category
from week-1-sql-511717.Sample_superstore_kaggle.superstore
group by category;

select category, sum(profit) as total_profit_per_cateogry
from week-1-sql-511717.Sample_superstore_kaggle.superstore
group by category;
