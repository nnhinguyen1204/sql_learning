-- Question: Find the region and category that lost money
-- Topics: COUNT, SUM, AVG; GROUP BY, HAVING 
-- Data source: Superstore from Kaggle, using Bigquey to code

select region, category,
       round(sum(sales), 2) as total_sales,
       round(sum(profit),2) as total_profit
from week-1-sql-511717.Sample_superstore_kaggle.superstore
group by region, category
having sum(profit) < 0
order by total_profit;
